#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
      // Fast homerow mods for stronger fingers (T, N - shift keys)
      hml_fast: homerow_mods_left_fast {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <120>;        // 50% shorter for shift keys
          quick-tap-ms = <80>;
          require-prior-idle-ms = <50>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 30 31 32 33>;
      };

      hmr_fast: homerow_mods_right_fast {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <120>;
          quick-tap-ms = <80>;
          require-prior-idle-ms = <50>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33>;
      };

      // Medium homerow mods for ctrl keys (S, E)
      hml_med: homerow_mods_left_medium {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <210>;
          quick-tap-ms = <125>;
          require-prior-idle-ms = <100>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 30 31 32 33>;
      };

      hmr_med: homerow_mods_right_medium {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <210>;
          quick-tap-ms = <125>;
          require-prior-idle-ms = <100>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33>;
      };

      // Slow homerow mods for weaker fingers (A, R, I, O - alt/gui)
      hml_slow: homerow_mods_left_slow {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <100>;
          require-prior-idle-ms = <50>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 30 31 32 33>;
      };

      hmr_slow: homerow_mods_right_slow {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <100>;
          require-prior-idle-ms = <50>;
          bindings = <&kp>, <&kp>;
          hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33>;
      };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Base (Colemak-DH)
        default_layer {
            bindings = <
&kp Q           &kp W           &kp F           &kp P           &kp B           &kp J    &kp L           &kp U           &kp Y           &kp SQT
&hml_slow LALT A &hml_slow LGUI R &hml_med LCTRL S &hml_fast LSHIFT T &kp G    &kp M &hmr_fast RSHIFT N &hmr_med RCTRL E &hmr_slow RGUI I &hmr_slow RALT O
&lt 7 Z         &kp X           &kp C           &kp D           &kp V           &kp K    &kp H           &kp COMMA       &kp DOT         &lt 7 SLASH
                                &kp LGUI        &lt 2 SPACE     &lt 1 ESC       &lt 3 TAB &lt 4 BSPC    &lt 5 ENTER
    >;

            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_DOWN C_AC_SCROLL_UP>;
        };

        // Layer 1: Function
        function_layer {
            bindings = <
&none           &none           &none           &none           &none           &kp PSCRN       &kp F7          &kp F8          &kp F9          &kp F12
&kp LALT        &kp LGUI        &kp LCTRL       &kp LSHIFT      &kp ESC         &kp PAUSE_BREAK &kp F4          &kp F5          &kp F6          &kp F11
&none           &none           &none           &none           &none           &kp SLCK        &kp F1          &kp F2          &kp F3          &kp F10
                                &none           &none           &trans          &kp TAB         &kp BSPC        &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Layer 2: Navigation
        navigation_layer {
            bindings = <
&none           &none           &none           &none           &none           &kp LG(LS(Z))   &kp LG(V)       &kp LG(C)       &kp LG(X)       &kp LG(Z)
&kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &kp ESC         &caps_word      &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT
&mo 6           &none           &none           &none           &none           &kp INS         &kp HOME        &kp PG_DN       &kp PG_UP       &kp END
                                &none           &trans          &none           &kp TAB         &kp DEL         &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Layer 3: Media
        media_layer {
            bindings = <
&none           &none           &none           &none           &none           &none           &none           &none           &none           &none
&kp C_PREV      &kp C_VOL_DN    &kp C_MUTE      &kp C_VOL_UP    &kp C_NEXT      &none           &kp LSHIFT      &kp LCTRL       &kp LGUI        &kp LALT
&none           &none           &none           &none           &none           &none           &none           &none           &none           &none
                                &kp C_PLAY_PAUSE &kp C_PLAY_PAUSE &kp C_STOP     &trans          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Layer 4: Numeral
        numeral_layer {
            bindings = <
&kp LBKT        &kp N7          &kp N8          &kp N9          &kp RBKT        &none           &none           &none           &none           &none
&kp SEMI        &kp N4          &kp N5          &kp N6          &kp EQUAL       &none           &kp LSHIFT      &kp LCTRL       &kp LGUI        &kp LALT
&kp GRAVE       &kp N1          &kp N2          &kp N3          &kp BSLH        &none           &none           &none           &none           &none
                                &kp LPAR        &kp N0          &kp MINUS       &none           &trans          &none
            >;

            sensor-bindings = <&inc_dec_kp LG(Z) LG(LS(Z))>;
        };

        // Layer 5: Symbols
        symbols_layer {
            bindings = <
&kp LBRC        &kp AMPS        &kp ASTRK       &kp LPAR        &kp RBRC        &none           &none           &none           &none           &none
&kp COLON       &kp CARET       &kp PRCNT       &kp DLLR        &kp PLUS        &none           &kp LSHIFT      &kp LCTRL       &kp LGUI        &kp LALT
&kp TILDE       &kp EXCL        &kp AT          &kp HASH        &kp PIPE        &none           &none           &none           &none           &none
                                &kp LPAR        &kp RPAR        &kp UNDER       &none           &none           &trans
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>;
        };

        // Layer 6: Virtual Mouse
        virtual_mouse_layer {
            bindings = <
&none           &none           &none           &none           &none           &none           &none           &none           &none           &none
&kp LGUI        &kp LALT        &kp LCTRL       &kp LSHIFT      &kp ESC         &none           &none           &none           &none           &none
&none           &none           &none           &none           &none           &none           &none           &none           &none           &none
                                &none           &none           &trans          &mkp MB3        &mkp MB1        &mkp MB2
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Layer 7: Pointer (accessed via Z and / keys)
        pointer_layer {
            bindings = <
&bootloader     &sys_reset      &none           &none           &none           &none           &none           &none           &sys_reset      &bootloader
&kp LALT        &kp LGUI        &kp LCTRL       &kp LSHIFT      &none           &none           &kp LSHIFT      &kp LCTRL       &kp LGUI        &kp LALT
&trans          &none           &none           &mkp MB3        &none           &none           &mkp MB3        &none           &none           &trans
                                &mkp MB3        &mkp MB2        &mkp MB1        &mkp MB1        &mkp MB2        &mkp MB3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
